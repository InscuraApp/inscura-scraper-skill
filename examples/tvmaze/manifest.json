{
  "id": "tvmaze-example",
  "name": "TVmaze Example",
  "version": "1.3.0",
  "description": "TVmaze public API for Inscura: TV shows, seasons, episodes and people; optional cast, crew, aliases and image URLs. No API key. Data: CC BY-SA 4.0.",
  "author": "Inscura",
  "homepage": "https://www.tvmaze.com/api",
  "apiVersion": 1,
  "entry": "index.js",
  "capabilities": [
    "tv",
    "actor"
  ],
  "providers": {
    "tv": [
      {
        "id": "tvmaze",
        "label": {
          "en": "TVmaze",
          "zh-CN": "TVmaze",
          "zh-TW": "TVmaze",
          "ja": "TVmaze",
          "ko": "TVmaze"
        }
      }
    ],
    "actor": [
      {
        "id": "tvmaze",
        "label": {
          "en": "TVmaze",
          "zh-CN": "TVmaze",
          "zh-TW": "TVmaze",
          "ja": "TVmaze",
          "ko": "TVmaze"
        }
      }
    ]
  },
  "config": [
    {
      "key": "includeImages",
      "type": "boolean",
      "label": {
        "en": "Include remote images",
        "zh-CN": "返回远程图片",
        "zh-TW": "傳回遠端圖片",
        "ja": "リモート画像を取得",
        "ko": "원격 이미지 포함"
      },
      "default": true,
      "required": false,
      "help": {
        "en": "Enabled by default to preserve image assets. Return image URLs; Inscura downloads supported images when applying metadata. Source image terms still apply. See <a href=\"https://www.tvmaze.com/site/copyright\">image rights</a>.",
        "zh-CN": "默认开启，保留重要图片资产。返回图片 URL；应用元数据时 Inscura 下载受支持的图片。仍须遵守来源图片使用条款。 参见<a href=\"https://www.tvmaze.com/site/copyright\">图片版权</a>。",
        "zh-TW": "預設開啟，保留重要圖片資產。回傳圖片 URL；套用中繼資料時 Inscura 下載支援的圖片。仍須遵守來源圖片使用條款。 請參閱<a href=\"https://www.tvmaze.com/site/copyright\">圖片版權</a>。",
        "ja": "画像資産を保持するため既定で有効です。画像 URL を返し、メタデータ適用時に Inscura が対応画像を取得します。提供元の画像利用条件が適用されます。 <a href=\"https://www.tvmaze.com/site/copyright\">画像の権利</a>を参照してください。",
        "ko": "중요한 이미지 자산을 보존하도록 기본으로 켜집니다. 이미지 URL을 반환하며 메타데이터 적용 시 Inscura가 지원 이미지를 다운로드합니다. 출처의 이미지 이용 약관이 적용됩니다. <a href=\"https://www.tvmaze.com/site/copyright\">이미지 권리</a>를 확인하세요."
      }
    },
    {
      "key": "includeCast",
      "type": "boolean",
      "default": true,
      "required": false,
      "label": {
        "en": "Include main cast",
        "zh-CN": "返回主要演员",
        "zh-TW": "傳回主要演員",
        "ja": "主要キャストを取得",
        "ko": "주요 출연진 포함"
      },
      "help": {
        "en": "Include show cast with linked person identities. Disabling omits the field and embedded cast request.",
        "zh-CN": "返回剧集主要演员及关联人物身份；关闭后省略演员字段及嵌入请求。",
        "zh-TW": "傳回影集主要演員及關聯人物身分；關閉後省略演員欄位及嵌入請求。",
        "ja": "人物情報に紐づく主要キャストを取得します。無効時は項目と埋め込み取得を省略します。",
        "ko": "인물 식별자가 연결된 주요 출연진을 포함합니다. 끄면 해당 필드와 포함 요청을 생략합니다."
      }
    },
    {
      "key": "includeCrew",
      "type": "boolean",
      "default": false,
      "required": false,
      "label": {
        "en": "Include show crew",
        "zh-CN": "返回剧组",
        "zh-TW": "傳回劇組",
        "ja": "制作スタッフを取得",
        "ko": "제작진 포함"
      },
      "help": {
        "en": "Fetch show-level crew. Adds one request per show detail.",
        "zh-CN": "获取剧集级剧组信息，每次剧集详情增加一次请求。",
        "zh-TW": "取得影集層級劇組資訊，每次影集詳情增加一次請求。",
        "ja": "番組の制作スタッフを取得します。番組詳細ごとにリクエストが1回増えます。",
        "ko": "프로그램 제작진을 조회합니다. 상세 조회마다 요청이 한 번 추가됩니다."
      }
    },
    {
      "key": "includeAliases",
      "type": "boolean",
      "default": false,
      "required": false,
      "label": {
        "en": "Include alternate show names",
        "zh-CN": "返回剧集别名",
        "zh-TW": "傳回影集別名",
        "ja": "番組の別名を取得",
        "ko": "프로그램 다른 제목 포함"
      },
      "help": {
        "en": "Fetch alternate show names. Adds one request; names are source data, not automatic translations.",
        "zh-CN": "获取剧集别名并增加一次请求；别名来自数据源，并非自动翻译。",
        "zh-TW": "取得影集別名並增加一次請求；別名來自資料來源，並非自動翻譯。",
        "ja": "別名を取得し、リクエストが1回増えます。別名は提供元のデータで、自動翻訳ではありません。",
        "ko": "다른 제목을 조회하며 요청이 한 번 추가됩니다. 제공처의 데이터이며 자동 번역이 아닙니다."
      }
    }
  ],
